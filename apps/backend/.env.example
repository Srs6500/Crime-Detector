# Copy to .env and fill in values. Do not commit .env.

DEBUG=false
# Local dev: SQLite (no Postgres needed). For production use Postgres:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/krogan
DATABASE_URL=sqlite+aiosqlite:///./krogan.db
JWT_SECRET_KEY=generate-a-long-random-secret

# Apple Sign In — required for backend to accept Sign in with Apple tokens
# APPLE_CLIENT_ID must be your iOS app bundle ID (com.krogan.app) — token verification will fail without it
APPLE_CLIENT_ID=com.krogan.app
# APPLE_TEAM_ID=   (optional; for server-side flows)
# APPLE_KEY_ID=    (optional; for server-side flows)

# Twilio (when implementing)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Redis (session state, guardian push, rate limiting)
REDIS_URL=redis://localhost:6379/0

# S3 / AWS (audio, photos, evidence)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_MEDIA=krogan-media

# APNs (iOS push for guardians)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.krogan.app
# APNS_KEY_PATH=path/to/AuthKey_xxx.p8

# Pinecone (vector DB for RAG — risk pipeline retrieval)
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=krogan-rag
# PINECONE_INDEX_HOST=  (optional; from Pinecone console or describe_index — avoids extra API call)
